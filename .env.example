# RentOS — environment variables
#
# Copy to .env for local (non-Docker) development, or set these in the
# Railway dashboard per service. Local `docker compose up` reads a subset
# via docker-compose.yml's own defaults — you only need this file for
# `pnpm dev` outside Docker, or to know what to configure on Railway.
#
# Which service needs which var is noted inline. Nothing here is a secret
# — replace every value before deploying anywhere real.

# ── Database (apps/api, apps/worker, packages/database) ─────────────────
# DATABASE_URL: the OWNING/migrator role. Used only by `prisma migrate
# deploy` and the seed script — never by running services. On Railway,
# this is the connection string the Postgres plugin gives you by default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentos?schema=public

# DATABASE_URL_APP: the RLS-enforced `rentos_app` role created by
# packages/database/prisma/migrations/*_enable_rls. apps/api and
# apps/worker connect with THIS, never DATABASE_URL — see docs/HANDOFF.md
# "RLS enforcement". Change the password from the migration's default
# ('changeme_in_production') before this ever touches a real deployment:
#   ALTER ROLE rentos_app WITH PASSWORD '<something real>';
DATABASE_URL_APP=postgresql://rentos_app:changeme_in_production@localhost:5432/rentos?schema=public

# ── Redis (apps/api for OTP cache, apps/worker for BullMQ queues) ───────
REDIS_URL=redis://localhost:6379

# ── Auth (apps/api) ───────────────────────────────────────────────────
# 32+ random bytes. `openssl rand -hex 32`
JWT_SECRET=
# DEV/DEMO ONLY — a fixed customer OTP that verifies without a real WhatsApp
# message (useful before the WhatsApp Cloud API is wired up). When set (and only
# when NODE_ENV is NOT "production"), submitting this exact code to /auth/otp/verify
# logs the customer in for ANY phone. IGNORED entirely in production, even if set.
# Leave BLANK to require real OTPs. Example: DEV_OTP_BYPASS_CODE=000000
DEV_OTP_BYPASS_CODE=

# ── CORS (apps/api) ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Messaging provider (apps/api, apps/worker) ───────────────────────
# console_log (default, zero external deps, logs to stdout + `notifications` table)
# whatsapp_cloud (real WhatsApp Cloud API — requires the two vars below)
MESSAGING_PROVIDER=console_log
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Payment provider (apps/api) ──────────────────────────────────────
# mock (default, auto-confirms every payment instantly, zero external deps)
# xendit (real Xendit gateway — requires the two vars below)
PAYMENT_PROVIDER=mock
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Object storage (apps/api — KYC documents) ────────────────────────
# local_disk (default, zero external deps — NOT safe for real PII on Railway
#   without a mounted Volume at UPLOAD_DIR; container disk is ephemeral otherwise)
# s3 (AWS S3 or any S3-compatible endpoint — Cloudflare R2, MinIO, etc.
#   via S3_ENDPOINT — requires the vars below)
STORAGE_PROVIDER=local_disk
UPLOAD_DIR=/tmp/rentos-uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── E-sign provider (apps/api — contract signing) ────────────────────
# mock (default, signs synchronously on upload — v1's wet-sign PDF
#   behavior, zero external deps)
# privy (real Privy digital-signature/e-Meterai API — requires the two
#   vars below; the contract stays PENDING until Privy's webhook fires)
ESIGN_PROVIDER=mock
PRIVY_API_KEY=
PRIVY_MERCHANT_KEY=

# ── apps/storefront (build-time — inlined into the client bundle) ────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Dev-only convenience: resolves tenant without wildcard DNS. Unset once
# the storefront is deployed on the tenant's real domain — production
# tenant resolution comes from the request Host (see
# apps/storefront/src/lib/tenant.ts).
NEXT_PUBLIC_DEV_TENANT_SLUG=gudang-aman

# ── apps/console (build-time — inlined into the client bundle) ───────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Console v1 is one deployment per tenant — see apps/console/src/lib/api.ts.
NEXT_PUBLIC_TENANT_SLUG=gudang-aman

# ── Misc ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
