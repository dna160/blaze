// RentOS core data model — docs/BUILD-SPEC.md (v2.0) supersedes PRD Appendix A
// where they conflict. Every tenant-owned table carries tenant_id and is
// protected by a Postgres RLS policy (see prisma/migrations/*_enable_rls and
// *_org_read_rls). The app connects with a non-owner role so RLS cannot be
// silently bypassed by table ownership — see docs/HANDOFF.md "RLS enforcement"
// for the full rationale. Prisma models use camelCase; every column is
// explicitly @map'd to snake_case so the database itself stays conventional SQL,
// independent of the ORM.
//
// BUILD-SPEC corrections realized here:
//   C1 — Organization → Tenant(=branch). Tenant.organizationId added; Location
//        kept as an optional descriptive row; Asset.locationId is now nullable.
//        Cross-tenant HO reads use a SEPARATE app.organization_id session var
//        (org_read_rls migration), read paths only. app.tenant_id write policy
//        is never widened.
//   C2 — UserRole is role × scope: BaseRole × RoleScope + tenantIds[].
//   C4 — RentalOrder (discrete, closed-ended monthly agreement) + renewal chain.
//   C5 — WaitlistEntry (an armed, conditionally-approved booking).
//   §5 — MasterAgreement (signed once) + OrderAcceptance (per-order OTP record).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../generated/client"
  // "native" covers local dev (whatever host you're running on); the
  // musl targets cover the Alpine-based Docker runtime images (infra/docker/*)
  // — Prisma's query engine is a native binary and silently fails at
  // runtime if the container's libc doesn't match what was generated.
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// C2 — the "what" axis of authorization. The six client role names are
/// (BaseRole × RoleScope) pairs; see docs/RBAC.md and packages/domain/src/rbac.
/// The vendor/platform super-user is modelled separately (User.tenantId = null),
/// not as a BaseRole.
enum BaseRole {
  ADMIN
  FINANCE
  SUPERVISOR
  STAFF
}

/// C2 — the "where" axis. ORGANIZATION = across all branches in the org (reads
/// only, per C1); TENANT = scoped to the tenantIds listed on the UserRole.
enum RoleScope {
  ORGANIZATION
  TENANT
}

enum BookingModel {
  RECURRING_LEASE
  NIGHTLY
  DURATION_ORDER
  HOURLY_SLOT
}

/// RECURRING_LEASE only — which configured rate a booking is priced against.
/// MONTHLY (default) is the original indefinite lease. DAILY/WEEKLY are
/// fixed-term bookings (real endDate, one upfront invoice, no recurring
/// cycle) — see packages/domain RecurringLeaseStrategy. Ignored for other
/// booking models.
enum RateTier {
  DAILY
  WEEKLY
  MONTHLY
}

enum AssetStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  RETIRED
}

/// Union of every state reachable by any BookingModel's lifecycle (PRD §8.1,
/// Appendix B). Which subset is legal for a given booking is enforced by the
/// state machine in @rentos/domain, not by this enum — Postgres only needs
/// to know the value is one of these.
enum BookingStatus {
  DRAFT
  /// RECURRING_LEASE only (PRD v2 §7): submitted while the chosen size/branch
  /// had no capacity for the requested window. Holds no unit. Staff
  /// "offer a unit" to move it to PENDING_APPROVAL once capacity frees up.
  WAITLISTED
  PENDING_APPROVAL
  NEEDS_INFO
  APPROVED
  REJECTED
  EXPIRED
  ACTIVE
  LAPSED
  RENEWING
  NOTICE_GIVEN
  SUSPENDED
  DEFAULT
  MOVED_OUT
  CLOSED
  PAID
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  EXTENDED
  PICKED_UP
  RETURNED
  INSPECTION
}

/// C4 — the discrete monthly rental lifecycle. Every month is its own
/// closed-ended RentalOrder; renewal produces a NEW order, gated on the
/// customer's H-14 confirmation. See packages/domain/src/rental-order.
enum RentalOrderStatus {
  PENDING_APPROVAL
  APPROVED
  AWAITING_PAYMENT
  ACTIVE
  RENEWAL_OFFERED
  RENEWAL_CONFIRMED
  RENEWAL_DECLINED
  EXPIRING
  COMPLETED
  DEFAULTED
  CANCELLED
}

/// C5 — a waitlist entry is an armed, conditionally-approved booking. FIRED =
/// a unit was released to it and a contract+invoice auto-generated; EXPIRED =
/// its fired invoice went unpaid past the payment TTL and the next entry fired.
enum WaitlistStatus {
  ARMED
  FIRED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

/// §5 — the once-per-customer master agreement, carrying all enforceable terms.
enum MasterAgreementStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

/// §5 — how a monthly RentalOrder was accepted against the signed master.
enum OrderAcceptanceMethod {
  OTP
  CLICK
}

enum InvoiceStatus {
  SCHEDULED
  ISSUED
  OVERDUE
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
  CREDITED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  VIRTUAL_ACCOUNT
  QRIS
  EWALLET
  CARD
  MANUAL_TRANSFER
  CASH
}

enum DepositStatus {
  HELD
  PARTIALLY_APPLIED
  APPLIED
  REFUND_REQUESTED
  REFUNDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

/// Who made the VERIFIED/REJECTED call on a KycDocument — AUTO means
/// KycVerificationProvider decided it without a human in the loop (Session
/// 21, Phase 4 automated KYC, PRD's P2 scope). A document a provider
/// couldn't decide on (PENDING) stays MANUAL and sits in the review queue
/// same as today. A staff override via KycService.review() always resets
/// this back to MANUAL, since the human decision supersedes automation.
enum KycVerificationSource {
  MANUAL
  AUTO
}

/// Which channel every customer-facing message goes out on (PRD v2 D3).
/// WHATSAPP is the default for phone/OTP customers; a customer who signed
/// in with Google (Clerk) is keyed by email and gets EMAIL instead.
enum CustomerChannel {
  WHATSAPP
  EMAIL
}

enum SwapRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Platform-level (RentOS's own SaaS revenue from a tenant), not to be
/// confused with a tenant's own Invoice model — see PlatformInvoice's own
/// doc comment. Static pricing/limits per plan live in code
/// (@rentos/domain's BILLING_PLANS), not a DB table — a short, fixed list
/// that rarely changes, same reasoning AssetType.pricing already applies
/// to per-tenant pricing config (Session 25).
enum BillingPlan {
  TRIAL
  STARTER
  GROWTH
  SCALE
}

enum PlatformInvoiceStatus {
  ISSUED
  PAID
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerAccount {
  ACCOUNTS_RECEIVABLE
  REVENUE
  DEPOSIT_LIABILITY
  CASH
  TAX_PAYABLE
  REFUND
}

// ---------------------------------------------------------------------------
// Organization & Tenancy  (C1)
// ---------------------------------------------------------------------------

/// C1 — the business entity (City Storage). Sits ABOVE Tenant. Not tenant-scoped;
/// like `tenants`, it is deliberately excluded from per-row tenant RLS (it is the
/// bootstrapping layer HO cross-tenant reads resolve through). Org-level
/// messaging config (#40 — one WA number for all branches) lives here.
model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  legalName       String?  @map("legal_name")
  /// #40 — org-level MessagingProvider credentials (one WA number, all branches).
  /// { provider, waPhoneNumberId, ... } — secrets injected at runtime, not stored raw.
  messagingConfig Json     @default("{}") @map("messaging_config")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenants          Tenant[]
  masterAgreements MasterAgreement[]

  @@map("organizations")
}

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  /// C1 — every Tenant (= one branch/location) belongs to an Organization.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String       @unique
  name           String
  legalName      String?      @map("legal_name")
  isPkp          Boolean      @default(false) @map("is_pkp")
  defaultLocale  String       @default("id") @map("default_locale")
  timezone       String       @default("Asia/Jakarta")
  branding       Json         @default("{}")
  /// Per-tenant feature flags. C3: { allowSubMonthly?: bool } gates DAILY/WEEKLY
  /// (default off). #27: { paymentMethods?: string[] } restricts allowed methods.
  /// Phase 4: { api_access_enabled?: bool } gates the external API and outbound
  /// webhooks; { adminNotifyRecipient?: string } is the dunning ladder's admin leg.
  featureFlags   Json         @default("{}") @map("feature_flags")
  /// Phase 4 tenant billing/metering. What RentOS charges this tenant, not what
  /// this tenant charges its own customers — see PlatformInvoice. Defaults every
  /// tenant (including seeded ones, who never went through self-serve signup) to
  /// TRIAL rather than leaving it null, so billing generation has a real value to
  /// work from for every tenant unconditionally.
  billingPlan    BillingPlan  @default(TRIAL) @map("billing_plan")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  domains              TenantDomain[]
  locations            Location[]
  users                User[]
  customers            Customer[]
  customerPhones       CustomerPhone[]
  assetTypes           AssetType[]
  assets               Asset[]
  bookings             Booking[]
  rentalOrders         RentalOrder[]
  waitlistEntries      WaitlistEntry[]
  masterAgreements     MasterAgreement[]
  invoices             Invoice[]
  payments             Payment[]
  automationSettings   AutomationSetting[]
  promoCodes           PromoCode[]
  apiKeys              TenantApiKey[]
  webhookSubscriptions TenantWebhookSubscription[]
  otaSubscriptions     OtaCalendarSubscription[]
  platformInvoices     PlatformInvoice[]

  @@index([organizationId])
  @@map("tenants")
}

model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain    String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_domains")
}

/// C1 — kept as an OPTIONAL descriptive row (address, timezone) for one release,
/// then droppable. The Tenant IS the branch now; Location no longer owns assets
/// as the primary scope (Asset.tenantId does), it just annotates them.
model Location {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  timezone  String   @default("Asia/Jakarta")
  /// WGS84 — drives the storefront's "closest branch to you" map (PRD v2 §4.1). Null = not shown on the map.
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assets   Asset[]
  bookings Booking[]

  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@map("locations")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// null => platform admin (vendor super-user, no tenant scope). See BUILD-SPEC C2.
  tenantId     String?    @map("tenant_id") @db.Uuid
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String?    @map("password_hash")
  displayName  String?    @map("display_name")
  status       String     @default("ACTIVE")
  roles        UserRole[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// C2 — role × scope. `tenantIds` is empty when scope = ORGANIZATION (applies
/// across the whole org, reads only per C1); one or more when scope = TENANT.
/// An array (not a single column) so covering two branches is a data edit, not a
/// migration (Ko Yudi's scenario). Encoding table: docs/RBAC.md §2.
model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BaseRole
  scope     RoleScope @default(TENANT)
  tenantIds String[]  @default([]) @map("tenant_ids") @db.Uuid

  @@unique([userId, role, scope])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// #4 — individual vs business registration drives which fields are required.
  type             CustomerType    @default(INDIVIDUAL)
  /// The primary phone. Additional WA numbers (#3, business accounts) live in
  /// CustomerPhone. Kept here for back-compat and as the canonical login handle.
  /// Nullable since PRD v2 D3: a Google-signed-in customer is keyed by email and
  /// may not have given a WhatsApp number yet.
  phone            String?
  email            String?
  fullName         String?         @map("full_name")
  /// #4 — business fields (null for INDIVIDUAL): company name, NPWP, PIC.
  companyName      String?         @map("company_name")
  taxId            String?         @map("tax_id")
  kycStatus        KycStatus       @default(NOT_SUBMITTED) @map("kyc_status")
  /// PRD v2 D3 — routes every outbound message. See CustomerChannel.
  preferredChannel CustomerChannel @default(WHATSAPP) @map("preferred_channel")
  /// Clerk user id for customers who signed in with Google (PRD v2 §9). Null for phone/OTP customers.
  clerkUserId      String?         @map("clerk_user_id")
  isBlocklisted    Boolean         @default(false) @map("is_blocklisted")
  blocklistReason  String?         @map("blocklist_reason")
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  kycDocuments     KycDocument[]
  phones           CustomerPhone[]
  bookings         Booking[]
  rentalOrders     RentalOrder[]
  waitlistEntries  WaitlistEntry[]
  masterAgreements MasterAgreement[]
  invoices         Invoice[]
  accessTokens     CustomerAccessToken[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, clerkUserId])
  @@index([tenantId])
  @@map("customers")
}

/// #3 — a business account maps multiple WhatsApp numbers to one Customer.
/// Each number is confirmed via OTP (verifiedAt) before it can act on the account.
model CustomerPhone {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([customerId])
  @@map("customer_phones")
}

/// Magic-link credential (PRD v2 §9): a customer-facing message carries
/// `{storefront}/m/{token}`; exchanging it issues a normal customer JWT
/// without an OTP round-trip. Only the SHA-256 hash is stored. Multi-use
/// until `expiresAt` (30 days) or `revokedAt`, one live token per
/// (customer, purpose) — re-issuing revokes the previous one.
model CustomerAccessToken {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  /// e.g. KYC | BOOKING | INVOICE | PORTAL — which message minted it, for audit only.
  purpose    String
  expiresAt  DateTime  @map("expires_at")
  useCount   Int       @default(0) @map("use_count")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_access_tokens")
}

model KycDocument {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType     String    @map("document_type")
  /// Encrypted object-storage key. The raw file never lands in this table.
  storageKey       String    @map("storage_key")
  status           KycStatus @default(PENDING_REVIEW)
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  verificationSource KycVerificationSource @default(MANUAL) @map("verification_source")
  /// KycVerificationProvider's external reference for this check (e.g. Verihubs' request id). Null when verificationSource is MANUAL.
  providerRef        String?               @map("provider_ref")
  /// Human-readable reason from the provider — shown to staff verbatim for AUTO-REJECTED docs, or an inconclusive AUTO check that fell back to the manual queue.
  providerReason     String?               @map("provider_reason")

  @@index([tenantId])
  @@index([customerId])
  @@map("kyc_documents")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model AssetType {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  bookingModel     BookingModel @map("booking_model")
  attributesSchema Json         @default("{}") @map("attributes_schema")
  /// { basePrice, currency, billingPeriod, depositRule, adminFee, prorationRule, taxInclusive }
  pricing          Json
  photos           Json         @default("[]")
  isPooled         Boolean      @default(false) @map("is_pooled")
  isPublished      Boolean      @default(false) @map("is_published")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  assets          Asset[]
  bookings        Booking[]
  rentalOrders    RentalOrder[]
  waitlistEntries WaitlistEntry[]
  swapRequests    SwapRequest[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("asset_types")
}

model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// C1 — now nullable: the Tenant is the branch; Location only annotates.
  locationId   String?     @map("location_id") @db.Uuid
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assetTypeId  String      @map("asset_type_id") @db.Uuid
  assetType    AssetType   @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  code         String
  status       AssetStatus @default(AVAILABLE)
  statusReason String?     @map("status_reason")
  attributes   Json        @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  bookings           Booking[]
  rentalOrders       RentalOrder[]
  swapRequestTargets SwapRequest[]
  otaSubscriptions   OtaCalendarSubscription[]
  otaBlockedDates    OtaBlockedDate[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([assetTypeId])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Booking & financial spine
// ---------------------------------------------------------------------------

model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId          String        @map("customer_id") @db.Uuid
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assetTypeId         String        @map("asset_type_id") @db.Uuid
  assetType           AssetType     @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  assetId             String?       @map("asset_id") @db.Uuid
  asset               Asset?        @relation(fields: [assetId], references: [id])
  /// The branch the customer chose (PRD v2 §4.1). Set for every RECURRING_LEASE booking since v2 — a WAITLISTED booking has no asset yet, so this is the only way to know where it wants to be.
  locationId          String?       @map("location_id") @db.Uuid
  location            Location?     @relation(fields: [locationId], references: [id])
  bookingModel        BookingModel  @map("booking_model")
  /// RECURRING_LEASE only — see RateTier. Ignored for other booking models.
  rateTier            RateTier      @default(MONTHLY) @map("rate_tier")
  status              BookingStatus @default(DRAFT)
  startDate           DateTime      @map("start_date")
  endDate             DateTime?     @map("end_date")
  /// Day-of-month billing anchor, RECURRING_LEASE only. Legacy — new RECURRING_LEASE
  /// flows use RentalOrder (C4); retained for NIGHTLY/DURATION_ORDER verticals.
  anchorDay           Int?          @map("anchor_day")
  /// RECURRING_LEASE term in months (1 / 3 / 6 / 12, PRD v2 D1). Null = a legacy indefinite month-to-month lease from before v2.
  termMonths          Int?          @map("term_months")
  /// Set when this booking extends a previous term on the same unit by the same customer — exempts it from the parent's blackout month (PRD v2 D2).
  extendsBookingId    String?       @map("extends_booking_id") @db.Uuid
  /// Pipeline timestamps (PRD v2 §5.1) — the stage is derived from these plus the customer's kycStatus and whether invoice #0 exists.
  kycRequestedAt      DateTime?     @map("kyc_requested_at")
  contractGeneratedAt DateTime?     @map("contract_generated_at")
  waitlistedAt        DateTime?     @map("waitlisted_at")
  /// Pricing terms frozen at submission time — never re-derived from AssetType later.
  priceSnapshot       Json          @map("price_snapshot")
  /// Soft-reservation TTL while PENDING_APPROVAL, prevents indefinite inventory lock.
  reservedUntil       DateTime?     @map("reserved_until")
  noticeGivenAt       DateTime?     @map("notice_given_at")
  noticeEffectiveDate DateTime?     @map("notice_effective_date")
  approvedByUserId    String?       @map("approved_by_user_id") @db.Uuid
  rejectionReason     String?       @map("rejection_reason")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  events       BookingEvent[]
  contracts    Contract[]
  invoices     Invoice[]
  deposits     Deposit[]
  swapRequests SwapRequest[]

  waitlistEntry WaitlistEntry?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([assetId])
  @@map("bookings")
}

/// Append-only audit trail — "every transition writes actor, timestamp, reason" (PRD §8.1).
model BookingEvent {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorType  String         @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_events")
}

/// §5 — the once-per-customer signed contract that RentalOrders reference.
/// Carries ALL enforceable terms; the certified e-signature is consumed here,
/// exactly once, not per monthly order.
model MasterAgreement {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Denormalised org ref so HO can list master agreements across branches.
  organizationId  String                @map("organization_id") @db.Uuid
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId      String                @map("customer_id") @db.Uuid
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateVersion String                @map("template_version")
  status          MasterAgreementStatus @default(DRAFT)
  documentUrl     String?               @map("document_url")
  esignProvider   String?               @map("esign_provider")
  esignEnvelopeId String?               @map("esign_envelope_id")
  signedAt        DateTime?             @map("signed_at")
  signedByName    String?               @map("signed_by_name")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  rentalOrders RentalOrder[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([customerId])
  @@map("master_agreements")
}

/// C4 — a single month's rental, a discrete closed-ended agreement. Renewal
/// generates a NEW order (previousOrderId chains them), gated on the customer's
/// H-14 confirmation. Replaces the old "one long-lived Booking + recurring
/// invoice cron" shape for RECURRING_LEASE (City Storage).
model RentalOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// §5 — the signed master this order accepts against. Null only for the very
  /// first order created before onboarding signature completes.
  masterAgreementId  String?           @map("master_agreement_id") @db.Uuid
  masterAgreement    MasterAgreement?  @relation(fields: [masterAgreementId], references: [id])
  customerId         String            @map("customer_id") @db.Uuid
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assetTypeId        String            @map("asset_type_id") @db.Uuid
  assetType          AssetType         @relation(fields: [assetTypeId], references: [id])
  /// C4/#11 — assigned by staff at approval, not chosen by the customer.
  assetId            String?           @map("asset_id") @db.Uuid
  asset              Asset?            @relation(fields: [assetId], references: [id])
  status             RentalOrderStatus @default(PENDING_APPROVAL)
  /// Real dates, both ends — every period is closed-ended (the client's core ask).
  periodStart        DateTime          @map("period_start")
  periodEnd          DateTime          @map("period_end")
  /// Pricing frozen at order creation — never re-derived from AssetType later.
  priceSnapshot      Json              @map("price_snapshot")
  /// C4 — the renewal chain. Null for a customer's first order.
  previousOrderId    String?           @map("previous_order_id") @db.Uuid
  previousOrder      RentalOrder?      @relation("RenewalChain", fields: [previousOrderId], references: [id])
  renewalOf          RentalOrder[]     @relation("RenewalChain")
  renewalOfferedAt   DateTime?         @map("renewal_offered_at")
  renewalRespondedAt DateTime?         @map("renewal_responded_at")
  reservedUntil      DateTime?         @map("reserved_until")
  approvedByUserId   String?           @map("approved_by_user_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  invoices          Invoice[]
  contracts         Contract[]
  events            RentalOrderEvent[]
  acceptances       OrderAcceptance[]
  waitlistFiredFrom WaitlistEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([assetId])
  @@index([previousOrderId])
  @@map("rental_orders")
}

/// Append-only audit trail for RentalOrder transitions — same discipline as
/// BookingEvent (actor, timestamp, reason on every transition).
model RentalOrderEvent {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  rentalOrderId String             @map("rental_order_id") @db.Uuid
  rentalOrder   RentalOrder        @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  fromStatus    RentalOrderStatus? @map("from_status")
  toStatus      RentalOrderStatus  @map("to_status")
  actorType     String             @map("actor_type")
  actorId       String?            @map("actor_id") @db.Uuid
  reason        String?
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([rentalOrderId])
  @@map("rental_order_events")
}

/// §5 — per-order acceptance evidence. NO certified signature is consumed here;
/// the master agreement carries the enforceable terms. This records the
/// OTP/click acceptance with a tamper-evidence bundle (UU ITE Art. 11).
model OrderAcceptance {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  rentalOrderId  String                @map("rental_order_id") @db.Uuid
  rentalOrder    RentalOrder           @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  method         OrderAcceptanceMethod
  acceptedAt     DateTime              @default(now()) @map("accepted_at")
  ipAddress      String?               @map("ip_address")
  userAgent      String?               @map("user_agent")
  /// OTP challenge id / verification record (NOT the OTP value itself).
  otpChallengeId String?               @map("otp_challenge_id")
  proof          Json                  @default("{}")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([rentalOrderId])
  @@map("order_acceptances")
}

/// C5 — an armed, conditionally-approved booking. Full customer data + KYC +
/// frozen price snapshot; everything except an assigned unit and a date. When a
/// unit is released it FIRES exactly one entry (single-fire row lock in the
/// service), auto-generating a contract + invoice. Payment TTL → EXPIRED → next.
model WaitlistEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetTypeId        String         @map("asset_type_id") @db.Uuid
  assetType          AssetType      @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  customerId         String         @map("customer_id") @db.Uuid
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  position           Int
  status             WaitlistStatus @default(ARMED)
  /// PRD v2 P3 — the conditionally-captured Booking this entry queues for. The
  /// Booking holds the customer record, the price snapshot and the message
  /// trail (one record, one WhatsApp thread); this row holds the queue
  /// mechanics C5 requires (position, single-fire row lock, payment TTL).
  /// Null for entries armed directly through the console waitlist API.
  bookingId          String?        @unique @map("booking_id") @db.Uuid
  booking            Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// The branch the customer asked for, and the window they asked for it in —
  /// what "Offer unit" must re-check availability against (PRD v2 §5.1).
  locationId         String?        @map("location_id") @db.Uuid
  location           Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  requestedStartDate DateTime?      @map("requested_start_date")
  termMonths         Int?           @map("term_months")
  /// KYC must be submitted & reviewed before arming — a fired entry auto-issues
  /// a contract, so we cannot wait on identity at fire time.
  kycVerified        Boolean        @default(false) @map("kyc_verified")
  priceSnapshot      Json           @map("price_snapshot")
  firedAt            DateTime?      @map("fired_at")
  expiresAt          DateTime?      @map("expires_at")
  firedRentalOrderId String?        @map("fired_rental_order_id") @db.Uuid
  firedRentalOrder   RentalOrder?   @relation(fields: [firedRentalOrderId], references: [id])
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@unique([tenantId, assetTypeId, position])
  @@index([tenantId])
  @@index([tenantId, assetTypeId, status])
  @@map("waitlist_entries")
}

model Contract {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  /// Legacy path (NIGHTLY/DURATION_ORDER bookings). Nullable now that
  /// RECURRING_LEASE contracts hang off RentalOrder instead.
  bookingId           String?      @map("booking_id") @db.Uuid
  booking             Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// C4 — the monthly order this contract documents (RECURRING_LEASE / City Storage).
  rentalOrderId       String?      @map("rental_order_id") @db.Uuid
  rentalOrder         RentalOrder? @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  templateVersion     String       @map("template_version")
  /// The uploaded document — under MockESignProvider this is already the
  /// final signed record (v1's wet-sign behavior); under a real ESignProvider
  /// it's the document that was sent out, replaced with the signed version
  /// once the provider's webhook confirms completion.
  documentUrl         String?      @map("document_url")
  /// The generated (unsigned) rental agreement PDF — PRD v2 P9. `documentUrl` above stays the signed version.
  unsignedDocumentUrl String?      @map("unsigned_document_url")
  signedAt            DateTime?    @map("signed_at")
  signedByName        String?      @map("signed_by_name")
  /// Set by whichever ESignProvider handled this contract (MOCK by default).
  esignProvider       String?      @map("esign_provider")
  esignEnvelopeId     String?      @map("esign_envelope_id")
  /// PENDING | SIGNED | DECLINED | EXPIRED — null until sendForSignature() is called.
  esignStatus         String?      @map("esign_status")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([bookingId])
  @@index([rentalOrderId])
  @@map("contracts")
}

model Invoice {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId             String?       @map("booking_id") @db.Uuid
  booking               Booking?      @relation(fields: [bookingId], references: [id])
  /// C4 — the monthly order this invoice bills (RECURRING_LEASE / City Storage).
  rentalOrderId         String?       @map("rental_order_id") @db.Uuid
  rentalOrder           RentalOrder?  @relation(fields: [rentalOrderId], references: [id])
  customerId            String        @map("customer_id") @db.Uuid
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Tenant-prefixed, sequential, tax-compliant (e.g. "STG/2026/07/000123").
  invoiceNumber         String        @map("invoice_number")
  status                InvoiceStatus @default(SCHEDULED)
  currency              String        @default("IDR")
  subtotal              Decimal       @db.Decimal(14, 2)
  taxAmount             Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount           Decimal       @map("total_amount") @db.Decimal(14, 2)
  issueDate             DateTime      @map("issue_date")
  dueDate               DateTime      @map("due_date")
  paidAt                DateTime?     @map("paid_at")
  voidedAt              DateTime?     @map("voided_at")
  /// #33 — who voided and why (SPV-gated). #34 — backdate supersede chain uses
  /// supersededByInvoiceId below.
  voidedByUserId        String?       @map("voided_by_user_id") @db.Uuid
  voidReason            String?       @map("void_reason")
  periodStart           DateTime?     @map("period_start")
  periodEnd             DateTime?     @map("period_end")
  supersededByInvoiceId String?       @map("superseded_by_invoice_id") @db.Uuid
  /// Position in a term's payment schedule (PRD v2 §8): 0 = the proforma
  /// (month 1 + deposit + admin fee), 1..N-1 = the monthly cycles. Null for
  /// invoices outside a schedule (legacy leases, credit replacements, final
  /// settlements, and C4 per-order invoices).
  scheduleIndex         Int?          @map("schedule_index")
  /// Generated PDF (proforma / invoice) storage key — see apps/api DocumentsService.
  documentUrl           String?       @map("document_url")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([rentalOrderId])
  @@map("invoices")
}

/// Backing store for `nextInvoiceNumber`'s atomic per-tenant-per-month
/// sequence (Session 24) — replaces the original `COUNT(*)`-based
/// derivation, which raced under concurrent invoice creation for the
/// same tenant (caught by Invoice's own `[tenantId, invoiceNumber]`
/// unique constraint as a hard failure, never a silent duplicate, but
/// still a real reliability bug under concurrent load). See
/// packages/database/src/invoice-number.ts.
model InvoiceNumberCounter {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  year     Int
  month    Int
  counter  Int    @default(0)

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@map("invoice_number_counters")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  /// RENT | DEPOSIT | ADMIN_FEE | TAX | DISCOUNT | DAMAGE
  lineType    String   @map("line_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId         String        @map("invoice_id") @db.Uuid
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// XENDIT | MIDTRANS | MANUAL | MOCK
  provider          String
  providerRef       String?       @map("provider_ref")
  idempotencyKey    String        @unique @map("idempotency_key")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(14, 2)
  paidAt            DateTime?     @map("paid_at")
  /// Set for manual entries — maker-checker: recorder != verifier (PRD §7.2.4).
  recordedByUserId  String?       @map("recorded_by_user_id") @db.Uuid
  verifiedByUserId  String?       @map("verified_by_user_id") @db.Uuid
  proofUrl          String?       @map("proof_url")
  rawWebhookPayload Json?         @map("raw_webhook_payload")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model CreditNote {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(14, 2)
  reason         String
  issuedByUserId String   @map("issued_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("credit_notes")
}

model Deposit {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  bookingId              String        @map("booking_id") @db.Uuid
  booking                Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount                 Decimal       @db.Decimal(14, 2)
  status                 DepositStatus @default(HELD)
  appliedAmount          Decimal       @default(0) @map("applied_amount") @db.Decimal(14, 2)
  refundApprovedByUserId String?       @map("refund_approved_by_user_id") @db.Uuid
  refundedAt             DateTime?     @map("refunded_at")
  payoutRef              String?       @map("payout_ref")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([bookingId])
  @@map("deposits")
}

/// PRD §7.1.4 "request upgrade/downsize... creates a swap request routed to
/// admin" + §7.2.4 Phase 2 scope. `newAssetId` is set on approval (the
/// specific replacement unit staff assigned), not at request time — the
/// customer only picks a target AssetType, staff picks the actual unit from
/// what's AVAILABLE.
model SwapRequest {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  bookingId              String            @map("booking_id") @db.Uuid
  booking                Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedAssetTypeId   String            @map("requested_asset_type_id") @db.Uuid
  requestedAssetType     AssetType         @relation(fields: [requestedAssetTypeId], references: [id])
  reason                 String?
  status                 SwapRequestStatus @default(PENDING)
  newAssetId             String?           @map("new_asset_id") @db.Uuid
  newAsset               Asset?            @relation(fields: [newAssetId], references: [id])
  reviewedByUserId       String?           @map("reviewed_by_user_id") @db.Uuid
  reviewedAt             DateTime?         @map("reviewed_at")
  rejectionReason        String?           @map("rejection_reason")
  /// Computed at approval (computeSwapProration) for staff to act on manually — positive means the
  /// customer owes more, negative means they're owed a credit. Null when no PAID invoice existed yet
  /// to derive the current billing period from.
  prorationNetAdjustment Decimal?          @map("proration_net_adjustment") @db.Decimal(14, 2)
  prorationDaysRemaining Int?              @map("proration_days_remaining")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([bookingId])
  @@map("swap_requests")
}

/// Double-entry, append-only. Balances are checked nightly (PRD §10 Reliability).
model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  account       LedgerAccount
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("IDR")
  /// INVOICE | PAYMENT | DEPOSIT | CREDIT_NOTE
  referenceType String          @map("reference_type")
  referenceId   String          @map("reference_id") @db.Uuid
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, referenceType, referenceId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Comms & automation
// ---------------------------------------------------------------------------

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  /// WHATSAPP | EMAIL
  channel       String
  templateKey   String    @map("template_key")
  /// #42 — a reminder fans out to both the customer and the branch admin;
  /// recipientRole records which side this row is (CUSTOMER | ADMIN).
  recipientRole String    @default("CUSTOMER") @map("recipient_role")
  recipient     String
  payload       Json      @default("{}")
  /// QUEUED | SENT | FAILED
  status        String    @default("QUEUED")
  providerRef   String?   @map("provider_ref")
  error         String?
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("notifications")
}

model AutomationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. "A5_INVOICE_REMINDER_LADDER" — see PRD §8.4 automation catalog.
  key       String
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("automation_settings")
}

model PromoCode {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  /// FLAT | PERCENT
  discountType   String    @map("discount_type")
  amount         Decimal   @db.Decimal(14, 2)
  /// FIRST_CYCLE | RECURRING
  appliesTo      String    @map("applies_to")
  maxRedemptions Int?      @map("max_redemptions")
  redeemedCount  Int       @default(0) @map("redeemed_count")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@map("promo_codes")
}

/// RentOS's own SaaS invoice TO a tenant for using the platform (PRD
/// Phase 4 "tenant billing"), deliberately a completely separate model
/// from `Invoice` (which is a tenant's invoice to ITS OWN customer) —
/// conflating the two would mix RentOS's revenue with a tenant's revenue
/// in the same table. Generated monthly (packages/database/src/platform-billing.ts,
/// shared by apps/api's on-demand trigger and apps/worker's monthly cron)
/// from a flat plan price plus a simple per-asset overage charge — see
/// @rentos/domain's computeMonthlyCharge. This never touches any
/// tenant's own ledger_entries; it is RentOS's own AR against the
/// tenant, tracked nowhere else in this schema (v1 has no ledger for
/// RentOS's own books — a real gap if this ever needs its own
/// accounting, out of scope for a metering/billing demo).
model PlatformInvoice {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingPlan      BillingPlan           @map("billing_plan")
  periodYear       Int                   @map("period_year")
  periodMonth      Int                   @map("period_month")
  includedAssets   Int                   @map("included_assets")
  actualAssetCount Int                   @map("actual_asset_count")
  planAmount       Decimal               @map("plan_amount") @db.Decimal(14, 2)
  overageAmount    Decimal               @map("overage_amount") @db.Decimal(14, 2)
  totalAmount      Decimal               @map("total_amount") @db.Decimal(14, 2)
  status           PlatformInvoiceStatus @default(ISSUED)
  issuedAt         DateTime              @default(now()) @map("issued_at")
  paidAt           DateTime?             @map("paid_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId])
  @@map("platform_invoices")
}

/// Immutable — protects the owner from his own staff (PRD §7.2.7).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("audit_log")
}

/// Idempotency + replay ledger for inbound gateway webhooks (PRD §10 Availability).
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  /// XENDIT | MIDTRANS | WHATSAPP
  provider    String
  externalId  String    @map("external_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@map("webhook_events")
}

// ---------------------------------------------------------------------------
// Phase 4 — tenant-facing API + outbound webhooks (PRD §13, Session 20)
// ---------------------------------------------------------------------------

/// Credentials a tenant's own systems use to call the read-only external API
/// (see ExternalApiModule). Gated per tenant by
/// `Tenant.featureFlags.api_access_enabled` — the key existing is not
/// itself sufficient, the flag must also be on. Only the SHA-256 hash of
/// the secret is stored; the plaintext is shown exactly once, at creation.
model TenantApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String
  /// First 8 chars of the plaintext key — lets staff tell keys apart in the console without ever storing the secret itself.
  keyPrefix       String    @map("key_prefix")
  keyHash         String    @unique @map("key_hash")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_api_keys")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A tenant's own system, registered to receive event notifications
/// (booking.approved, invoice.paid, payment.received — see
/// packages/contracts/src/platform-api.ts's WEBHOOK_EVENT_TYPES).
model TenantWebhookSubscription {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url             String
  /// Shared secret used to HMAC-SHA256-sign delivered payloads (X-RentOS-Signature header) — shown once, at creation.
  secret          String
  eventTypes      String[] @map("event_types")
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deliveries TenantWebhookDelivery[]

  @@index([tenantId])
  @@map("tenant_webhook_subscriptions")
}

/// One delivery attempt record per (subscription, event) — created PENDING
/// when WebhookDispatcherService enqueues it, updated by apps/worker's
/// delivery job once the HTTP POST resolves (or exhausts BullMQ's retries).
model TenantWebhookDelivery {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id") @db.Uuid
  subscriptionId String                    @map("subscription_id") @db.Uuid
  subscription   TenantWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String                    @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus     @default(PENDING)
  httpStatus     Int?                      @map("http_status")
  attempt        Int                       @default(0)
  error          String?
  createdAt      DateTime                  @default(now()) @map("created_at")
  deliveredAt    DateTime?                 @map("delivered_at")

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("tenant_webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 4 — OTA channel calendar sync via iCal (PRD §13, Session 22)
// ---------------------------------------------------------------------------

enum OtaSyncStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One inbound iCal import per Asset (one real-world listing = one
/// physical Asset = one external calendar) — gated by
/// `Tenant.featureFlags.ota_sync_enabled`. apps/worker's
/// sync-ota-calendars job fetches `sourceUrl` on a schedule and turns its
/// VEVENTs into OtaBlockedDate rows, so a guest booked directly through
/// Airbnb/Booking.com doesn't get double-booked through RentOS. See
/// docs/HANDOFF.md Session 22.
model OtaCalendarSubscription {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId         String        @map("asset_id") @db.Uuid
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label           String
  sourceUrl       String        @map("source_url")
  isActive        Boolean       @default(true) @map("is_active")
  lastSyncedAt    DateTime?     @map("last_synced_at")
  lastSyncStatus  OtaSyncStatus @default(PENDING) @map("last_sync_status")
  lastSyncError   String?       @map("last_sync_error")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  blockedDates OtaBlockedDate[]

  @@index([tenantId])
  @@index([assetId])
  @@map("ota_calendar_subscriptions")
}

/// A single blocked date range parsed out of a subscription's iCal feed.
/// `externalUid` is the source VEVENT's UID — resyncing upserts on
/// (subscriptionId, externalUid) so a still-present reservation on the
/// external calendar doesn't duplicate, and a cancelled one can be
/// cleanly replaced. `BookingService.createBooking`'s non-pooled NIGHTLY
/// asset selection excludes any Asset with an overlapping row here,
/// exactly like `computePooledAvailableCount` excludes overlapping
/// Bookings for pooled types.
model OtaBlockedDate {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  assetId        String                  @map("asset_id") @db.Uuid
  asset          Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  subscriptionId String                  @map("subscription_id") @db.Uuid
  subscription   OtaCalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  externalUid    String                  @map("external_uid")
  startDate      DateTime                @map("start_date")
  endDate        DateTime                @map("end_date")
  createdAt      DateTime                @default(now()) @map("created_at")

  @@unique([subscriptionId, externalUid])
  @@index([tenantId])
  @@index([assetId])
  @@map("ota_blocked_dates")
}
